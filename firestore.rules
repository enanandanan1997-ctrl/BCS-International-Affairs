rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidNewspaperSource(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.englishName is string && data.englishName.size() <= 100 &&
             data.section is string && data.section.size() <= 100 &&
             data.webUrl is string && data.webUrl.size() > 0 && data.webUrl.size() <= 500 &&
             (!('rssUrl' in data) || data.rssUrl is string && data.rssUrl.size() <= 500) &&
             data.category is string && data.category.size() <= 50 &&
             data.isActive is bool &&
             data.isDefault is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserProfile(data) {
      return (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.lastLoginAt is timestamp && data.lastLoginAt <= request.time;
    }

    match /users/{userId} {
      match /profile/{profileId} {
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /newspapers/{newspaperId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(newspaperId) &&
                         isValidNewspaperSource(request.resource.data);
        allow update: if isOwner(userId) &&
                         isValidId(newspaperId) &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         isValidNewspaperSource(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
